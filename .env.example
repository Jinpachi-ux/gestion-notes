# Copier ce fichier en ".env" puis adapter si besoin.
# Valeurs par défaut de WampServer : utilisateur root, mot de passe vide.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_notes

PORT=3000

# Mettre à 1 pour forcer le calcul en JavaScript (sans le programme C++)
FORCE_JS=0
